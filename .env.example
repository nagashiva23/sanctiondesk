# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Role-scoped tools (policy management, fairness audit, tamper demo, human
# override, token revocation) and the full policy/ledger detail on decision
# tools are gated by JWT. See src/auth/roles.ts for the full role -> scope
# matrix.
# JWT_REQUIRED unset or not "true": every caller is auto-granted every scope --
#   this is intentional for local Studio testing, where there is no auth client.
# JWT_REQUIRED=true (set this before deploying publicly): callers must send
#   an "authorization": "Bearer <token>" field in the tool call's _meta, with
#   a token minted by scripts/mint-token.mjs (requires JWT_SECRET).
#
# Roles: LOAN_OFFICER, RISK_COMPLIANCE_OFFICER, POLICY_ADMIN, AUDITOR, SUPER_ADMIN
#   JWT_SECRET=... node scripts/mint-token.mjs --role=LOAN_OFFICER
#
# JWT_SECRET=change-me-to-a-long-random-value
# JWT_REQUIRED=true

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
