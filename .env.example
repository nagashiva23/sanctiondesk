# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# This MCP server is unauthenticated by design -- it only exposes
# client-facing loan underwriting tools (assess_affordability,
# run_policy_gates, price_risk_loan, sanction_decision, find_max_eligible,
# simulate_scenario, generate_sanction_letter). There is no manager tier,
# no JWT, and nothing to configure here for auth. Policy management,
# fairness auditing, and audit-chain sealing are manager-only features
# handled entirely by the separate Next.js manager console
# (src/demo-login), gated by its own login -- not by this server.

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
