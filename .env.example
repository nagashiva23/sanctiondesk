# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Two-tier auth: CLIENT (no token -- self-serve, redacted responses) or
# MANAGER (any validly-signed token -- policy management, fairness audit,
# tamper demo, human override, token revocation, full unredacted detail).
# There is no further role differentiation.
# JWT_REQUIRED unset or not "true": every caller is auto-treated as a manager --
#   this is intentional for local Studio testing, where there is no auth client.
# JWT_REQUIRED=true (set this before deploying publicly): manager callers must
#   send an "authorization": "Bearer <token>" field nested inside the tool
#   call's arguments (arguments._meta.authorization), with a token minted by
#   scripts/mint-token.mjs (requires JWT_SECRET).
#
#   JWT_SECRET=... node scripts/mint-token.mjs alice
#
# JWT_SECRET=change-me-to-a-long-random-value
# JWT_REQUIRED=true

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
